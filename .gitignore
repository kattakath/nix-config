# Claude Code — personal overrides and worktree scratch
.claude/settings.local.json
*.local.md
.claude/worktrees/
.worktrees/

# superhook runtime artifacts
.claude/hooks/superhook.log
.claude/hooks/.superhook-state.json

# pretooluse-log.js observer runtime artifact
.claude/hooks/pretooluse.log

# routing-review.md state (events themselves live outside the repo, under
# ~/.local/state/claude-otel/ — see modules/shared/claude-otel.nix)
.claude/hooks/.routing-review-state.json

# Project memory — candid, local-only record of decisions/reasoning/findings/values.
# Gitignored on purpose: this is the "why" behind the repo, not committed documentation.
memory/

# macOS Finder cruft
.DS_Store
.DS_Store?
.AppleDouble
._*
tmp

# Nix build artifacts
result
result-*
# nix-direnv's cache dir — direnv itself was removed from this repo, but the
# devcontainer (or any stray nix-direnv run) can still regenerate .direnv/.
# Ignored as a generated artifact so `git add -A` never sweeps it into a commit.
.direnv/

# Disk / VM images — built locally, never committed
*.qcow2
*.img
*.iso
*.vmdk
*.ova
*.utm


# git-hooks.nix generates this from flake.nix on `nix develop` — never commit it
.pre-commit-config.yaml

# qwen CLI's own local runtime state (project-local settings.json it writes on
# launch, containing machine-specific absolute paths) — never commit it
.qwen/

# Secrets and local env
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.secrets

# OpenTofu/Terraform working files — generated beside where a cf-*-apply app is
# run (the rendered config.tf.json is a store copy; state + the provider plugin
# dir must never be committed, and state can contain the sensitive tunnel token).
config.tf.json
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
