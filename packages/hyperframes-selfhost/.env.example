# ---- Tailscale (Funnel runs ONLY on the Linux VM) ----------------------------
# Create at https://login.tailscale.com/admin/settings/keys
# Reusable recommended for first VM join; not ephemeral.
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_HOSTNAME=hyperframes
# Optional: pin your tailnet name for EXTERNAL_URL if auto-detect fails
# TS_TAILNET_NAME=tail12345.ts.net

# ---- Public URL (HTTPS Funnel) -----------------------------------------------
# Leave empty on first install — install.sh fills https://<TS_HOSTNAME>.<tailnet>.ts.net
EXTERNAL_URL=

# ---- Google OAuth (Testing mode) ---------------------------------------------
# Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated exact emails (must also be Google "Test users" while in Testing)
GOOGLE_ALLOWED_USERS=you@example.com

# ---- Workspace (media in/out on the VM) --------------------------------------
WORKSPACE_DIR=./workspace

# ---- Optional tuning ---------------------------------------------------------
# Caddy listen inside the shared network namespace (Funnel proxies here)
CADDY_HTTP_PORT=8080
# mcp-auth-proxy listen (loopback relative to shared netns)
MCP_LISTEN=:8090
