{
  // nix-config devcontainer: a PREBUILT, Nix-built image. The whole toolchain —
  // a working multi-user nix (flakes + public Cachix), the warm devShell
  // closure (nixd/nixfmt/treefmt/statix/deadnix/home-manager), node, claude-code,
  // gh — is baked into the image by this repo's flake.nix
  // (packages/devcontainer-image.nix, dockerTools.streamLayeredImage) and
  // published multi-arch to GHCR by .github/workflows/build-devcontainer.yml.
  // Inside the container, `nix develop` resolves from the baked, DB-registered
  // /nix/store: no build, no download.
  //
  // This file keeps ONLY what an image cannot carry: the workspace mount, the
  // VS Code extensions/settings, and the terminal profiles.
  //
  // Published under the short, unnamespaced ghcr.io/kattakath/devcontainer
  // name (this is the repo's sole/default devcontainer).
  // `:latest` on purpose (ADR-012 § 5): this repo IS the publisher, and :latest is
  // the image built from main's own inputs. A `:<sha12>` pin would need a bot
  // committing back after every publish and would go stale without one.
  "name": "nix-config (prebuilt Nix devcontainer image)",
  "image": "ghcr.io/kattakath/devcontainer:latest",
    
  // Literal on purpose: packages/devcontainer-image.nix (workdir) and build-devcontainer-impl.yml
  // bake the same path, and the localWorkspaceFolderBasename variable is a worktree's name in a worktree.
  // remoteUser, updateRemoteUserUID, overrideCommand and init live in the IMAGE's
  // `devcontainer.metadata` label (packages/devcontainer-image.nix), one copy for every
  // consumer; CI's devcontainer guard proves the merged result.
  //
  // Codespaces chooses the machine before it pulls the image, so this cannot be a label.
  // Judgment, not measured: `nix flake check` over four hosts wants more than the minimum.
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },

  "workspaceFolder": "/workspaces/nix-config",

  // The bind-mounted checkout is owned by the HOST user. When that UID is not 1000
  // (a Linux host, a CI runner) git and Nix's libgit2 refuse it as "not owned by
  // current user", and `nix develop` fails. updateRemoteUserUID stays false (fakeNss
  // makes /etc/passwd read-only), so trust the one workspace folder instead. `-C /`: git
  // must not inspect the workspace first, or a git WORKTREE (whose .git points at a host
  // path absent in the container) fails the command itself.
  "postStartCommand": "git -C / config --global --add safe.directory ${containerWorkspaceFolder}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/nix-config,type=bind",

  // IMPORTANT: no mount over /nix — that would shadow the baked, warm store the
  // image ships. The container's own overlay makes /nix/store writable for new
  // builds. Project memory (`memory/`) rides the workspaceMount bind (gitignored,
  // host<->container). No volume for ~/.claude (deliberate — don't re-add one).

  "customizations": {
    "vscode": {
      // Claude Code >= 2.1.318 no longer installs its VS Code extension itself
      // (code.claude.com/docs/en/vs-code), so it is listed here.
      "extensions": [
        "anthropic.claude-code",
        "jnoortheen.nix-ide",
        "gruntfuggly.triggertaskonsave",
        "fuadpashayev.bottom-terminal",
        "shd101wyy.markdown-preview-enhanced"
      ],
      "settings": {
        // nixd/nixfmt resolve from the baked PATH.
        "nix.enableLanguageServer": true,
        "nix.serverPath": "nixd",
        "nix.formatterPath": "nixfmt",
        "nix.serverSettings": {
          "nixd": {
            "formatting": { "command": ["nixfmt"] }
          }
        },

        "editor.formatOnSave": true,
        "[nix]": {
          "editor.defaultFormatter": "jnoortheen.nix-ide"
        },

        // On .nix save, run the "nix: lint" task (statix/deadnix -> Problems).
        "triggerTaskOnSave.on": true,
        "triggerTaskOnSave.showNotifications": false,
        "triggerTaskOnSave.tasks": {
          "nix: lint": ["**/*.nix"]
        },

        // Default terminal enters the flake devShell so the pinned
        // nixd/nixfmt/statix/deadnix are on PATH (the on-convention alternative
        // to direnv). Because the closure is baked, `nix develop` is instant.
        // "zsh" is the recovery shell if a broken flake eval fails the devShell.
        "terminal.integrated.defaultProfile.linux": "nix develop",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "bash" },
          "nix develop": {
            "path": "bash",
            "args": ["-lc", "exec nix develop"],
            "icon": "beaker"
          },
          "claude": {
            "path": "bash",
            "args": ["-lc", "exec nix develop -c claude --permission-mode bypassPermissions"],
            "icon": "claude",
            "color": "terminal.ansiYellow"
          }
        }
      }
    }
  }
}
